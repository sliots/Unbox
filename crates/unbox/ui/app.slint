// Unbox progress window — modelled on the Windows 11 file copy dialog.
import { LineEdit, CheckBox, ScrollView, Button, Palette } from "std-widgets.slint";

export struct EncodingChoice {
    label: string,
    samples: string,
}

// Visual state of the task.
export enum TaskState { running, paused, verifying, done, warning, failed }

// Which sheet is shown over the window.
export enum PromptKind { none, password, invalid-names, encoding, recycle-notice, budget }

global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #202020 : #ffffff;
    out property <color> footer: dark ? #1c1c1c : #f3f3f3;
    out property <color> card: dark ? #2b2b2b : #f9f9f9;
    out property <color> border: dark ? #383838 : #d7d7d7;
    out property <color> text: dark ? #ffffff : #1a1a1a;
    out property <color> subtext: dark ? #b9b9b9 : #646464;
    out property <color> hover: dark ? #ffffff14 : #0000000d;
    out property <color> pressed: dark ? #ffffff0d : #00000014;
    out property <color> track: dark ? #ffffff1f : #0000001a;
    out property <color> accent: dark ? #4cc2ff : #107c41;
    out property <color> paused: dark ? #fce100 : #c19c00;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> grid: dark ? #ffffff16 : #00000016;
    out property <color> graph-border: dark ? #555555b2 : #cdcdcdb2;
    out property <color> reference: dark ? #ffffff96 : #00000096;
}

// Flat icon button (pause / cancel) with an animated hover wash.
component IconButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked();
    width: 30px;
    height: 28px;
    border-radius: 4px;
    background: !enabled ? transparent : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 120ms; }
    animate opacity { duration: 150ms; }
    accessible-role: button;
    accessible-label: tooltip;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <color> accent: Theme.accent;
    callback clicked();
    height: 30px;
    min-width: label.preferred-width + 32px;
    border-radius: 4px;
    background: primary ? (touch.pressed ? accent.darker(0.2) : touch.has-hover ? accent.brighter(0.08) : accent)
                        : (touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.card);
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: text;
    label := Text {
        text: root.text;
        color: root.primary ? (Theme.dark ? #000000 : #ffffff) : Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Radio inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    in property <string> detail;
    callback clicked();
    height: layout.preferred-height;
    accessible-role: radio-button;
    accessible-checked: checked;
    accessible-label: text;
    layout := HorizontalLayout {
        spacing: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: root.checked ? 0px : 1px;
                border-color: Theme.subtext;
                background: root.checked ? Theme.accent : transparent;
                animate background { duration: 150ms; }
                Rectangle {
                    width: root.checked ? 6px : (touch.has-hover ? 10px : 0px);
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.checked ? (Theme.dark ? #000000 : #ffffff) : Theme.subtext;
                    animate width { duration: 160ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                }
            }
        }
        VerticalLayout {
            spacing: 1px;
            Text { text: root.text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
            if root.detail != "": Text { text: root.detail; color: Theme.subtext; font-size: 11px; wrap: word-wrap; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Progress bar with a smoothly animated fill and an indeterminate sweep.
component ProgressTrack inherits Rectangle {
    in property <float> value;
    in property <bool> indeterminate;
    in property <color> fill;
    height: 12px;
    border-radius: 2px;
    background: Theme.track;
    clip: true;
    property <float> sweep: Math.mod(animation-tick() / 1ms, 1700) / 1700;
    Rectangle {
        x: root.indeterminate ? (root.sweep * 1.4 - 0.4) * root.width : 0px;
        width: root.indeterminate ? root.width * 0.4 : root.width * clamp(root.value, 0, 1);
        height: root.height;
        border-radius: 2px;
        background: root.fill;
        animate width { duration: 280ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate background { duration: 250ms; }
    }
}

component SpeedGraph inherits Rectangle {
    in property <string> area;
    in property <float> progress;
    in property <length> reference-y;
    in property <string> label;
    in property <color> fill;
    height: 92px;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.graph-border;
    clip: true;

    Rectangle {
        x: 0px;
        width: root.width * clamp(root.progress, 0, 1);
        background: root.fill.with-alpha(0.15);
        animate width { duration: 280ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate background { duration: 250ms; }
    }
    Path {
        x: 0px;
        y: 0px;
        width: 448px;
        height: 92px;
        viewbox-width: 448;
        viewbox-height: 92;
        commands: root.area;
        fill: root.fill;
        animate fill { duration: 250ms; }
    }
    Rectangle {
        x: root.width * clamp(root.progress, 0, 1);
        width: 1px;
        background: root.fill;
        visible: root.progress > 0.001;
        animate x { duration: 280ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    for n[i] in 5: Rectangle {
        y: root.height * (i + 1) / 6;
        height: 1px;
        background: Theme.grid;
    }
    for n[i] in 9: Rectangle {
        x: root.width * (i + 1) / 10;
        width: 1px;
        background: Theme.grid;
    }
    Rectangle {
        y: root.reference-y;
        height: 1px;
        background: Theme.reference;
        animate y { duration: 300ms; easing: ease-out; }
    }
    speed := Text {
        text: root.label;
        font-size: 11.5px;
        color: Theme.text;
        x: root.width - self.width - 10px;
        y: root.reference-y - self.height - 2px < 2px ? root.reference-y + 3px : root.reference-y - self.height - 2px;
        animate y { duration: 300ms; easing: ease-out; }
    }
}

component StatusGlyph inherits Rectangle {
    in property <TaskState> state;
    property <bool> shown: state == TaskState.done || state == TaskState.failed || state == TaskState.warning;
    property <color> tone: state == TaskState.done ? Theme.success : state == TaskState.failed ? Theme.danger : Theme.warning;
    width: shown ? 20px : 0px;
    height: 20px;
    animate width { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    Rectangle {
        width: root.shown ? 18px : 4px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.tone;
        opacity: root.shown ? 1 : 0;
        animate width { duration: 320ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate opacity { duration: 200ms; }
        if root.state == TaskState.done: Path {
            width: 10px;
            height: 8px;
            viewbox-width: 10;
            viewbox-height: 8;
            commands: "M 1 4.2 L 3.8 7 L 9 1.2";
            stroke: Theme.dark ? #000000 : #ffffff;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            fill: transparent;
        }
        if root.state != TaskState.done: Text {
            text: "!";
            color: Theme.dark ? #000000 : #ffffff;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    // ----- Data pushed from Rust -----
    in property <string> title-text: "Unbox";
    in property <string> path-info: "正在读取压缩包…";
    in property <string> status-text: "正在打开压缩包…";
    in property <TaskState> state: TaskState.running;
    in property <bool> indeterminate: true;
    in property <float> progress;
    in-out property <bool> expanded;
    in property <string> detail-name: "准备中…";
    in property <string> detail-eta: "正在计算…";
    in property <string> detail-remaining: "正在计算…";
    in property <string> graph-area;
    in property <float> graph-progress;
    in property <length> graph-reference-y: 88px;
    in property <string> graph-label;
    in-out property <bool> recycle-checked;
    in property <bool> controls-enabled: true;
    in property <bool> finished;
    in property <bool> can-open-folder;
    in property <bool> appeared;

    // ----- Prompt sheet -----
    in property <PromptKind> prompt: PromptKind.none;
    in property <string> prompt-title;
    in property <string> prompt-submit: "确定";
    in property <string> prompt-detail;
    in property <[string]> invalid-names;
    in property <[EncodingChoice]> encodings;
    in-out property <int> prompt-choice;
    in-out property <bool> prompt-remember;
    in-out property <string> prompt-input;
    in property <string> prompt-error;

    callback pause-clicked();
    callback cancel-clicked();
    callback toggle-details();
    callback recycle-toggled(bool);
    callback open-folder();
    callback close-clicked();
    callback prompt-accepted();
    callback prompt-dismissed();

    title: root.title-text;
    icon: @image-url("../../../appicon/package-box.png");
    default-font-family: "Microsoft YaHei UI";
    background: Theme.background;

    property <bool> prompt-open: root.prompt != PromptKind.none;
    property <color> accent: root.state == TaskState.paused ? Theme.paused
        : root.state == TaskState.failed ? Theme.danger
        : root.state == TaskState.warning ? Theme.warning
        : Theme.accent;
    property <length> wanted-height: root.prompt-open ? max(main.preferred-height, sheet.preferred-height) : main.preferred-height;
    out property <length> shown-height: root.wanted-height;
    animate shown-height { duration: 240ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    property <float> chevron: root.expanded ? 1 : 0;
    animate chevron { duration: 220ms; easing: ease-in-out; }

    min-width: 480px;
    max-width: 480px;
    preferred-width: 480px;
    min-height: root.shown-height;
    max-height: root.shown-height;
    preferred-height: root.shown-height;

    // ===================== Main content =====================
    content := Rectangle {
        x: 0px;
        y: root.appeared ? 0px : 8px;
        width: root.width;
        height: root.height;
        opacity: root.prompt-open ? 0 : (root.appeared ? 1 : 0);
        animate opacity { duration: 220ms; easing: ease-out; }
        animate y { duration: 320ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

        main := VerticalLayout {
            x: 0px;
            y: 0px;
            width: root.width;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 0px;
            alignment: start;

            Text {
                text: root.path-info;
                font-size: 12px;
                color: Theme.text;
                overflow: elide;
                height: 18px;
                vertical-alignment: center;
            }

            HorizontalLayout {
                height: 34px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    StatusGlyph { state: root.state; }
                }
                status := Text {
                    text: root.status-text;
                    font-size: 18px;
                    color: root.state == TaskState.failed ? Theme.danger : root.state == TaskState.warning ? Theme.warning : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    animate color { duration: 250ms; }
                }
                if !root.finished: HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            tooltip: root.state == TaskState.paused ? "继续" : "暂停";
                            enabled: root.controls-enabled;
                            clicked => { root.pause-clicked(); }
                            if root.state == TaskState.paused: Path {
                                width: 9px;
                                height: 10px;
                                viewbox-width: 9;
                                viewbox-height: 10;
                                commands: "M 0.5 0.5 L 8.5 5 L 0.5 9.5 Z";
                                fill: Theme.text;
                            }
                            if root.state != TaskState.paused: HorizontalLayout {
                                alignment: center;
                                spacing: 3px;
                                padding-top: 9px;
                                padding-bottom: 9px;
                                Rectangle { width: 2.5px; background: Theme.text; border-radius: 1px; }
                                Rectangle { width: 2.5px; background: Theme.text; border-radius: 1px; }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            tooltip: "取消";
                            clicked => { root.cancel-clicked(); }
                            Path {
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
                                stroke: Theme.text;
                                stroke-width: 1.2px;
                                stroke-line-cap: round;
                                fill: transparent;
                            }
                        }
                    }
                }
                if root.finished: HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        if root.can-open-folder: AccentButton {
                            text: "打开文件夹";
                            accent: Theme.accent;
                            clicked => { root.open-folder(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        AccentButton {
                            text: "关闭";
                            primary: !root.can-open-folder;
                            accent: root.state == TaskState.failed ? Theme.danger : Theme.accent;
                            clicked => { root.close-clicked(); }
                        }
                    }
                }
            }

            // Collapsed view: the classic 12 px bar.
            Rectangle {
                height: root.expanded ? 0px : 30px;
                opacity: root.expanded ? 0 : 1;
                clip: true;
                animate height { duration: 220ms; easing: ease-in-out; }
                animate opacity { duration: 180ms; }
                ProgressTrack {
                    y: 5px;
                    width: parent.width;
                    value: root.progress;
                    indeterminate: root.indeterminate;
                    fill: root.accent;
                }
            }

            // Expanded view: throughput graph and three detail rows.
            Rectangle {
                height: root.expanded ? 164px : 0px;
                opacity: root.expanded ? 1 : 0;
                clip: true;
                animate height { duration: 220ms; easing: ease-in-out; }
                animate opacity { duration: 220ms; easing: ease-in; }
                VerticalLayout {
                    y: 4px;
                    height: 160px;
                    spacing: 4px;
                    SpeedGraph {
                        area: root.graph-area;
                        progress: root.graph-progress;
                        reference-y: root.graph-reference-y;
                        label: root.graph-label;
                        fill: root.accent;
                    }
                    Rectangle { height: 4px; }
                    for row in [
                        { k: "名称：", v: root.detail-name },
                        { k: "剩余时间：", v: root.detail-eta },
                        { k: "剩余项目：", v: root.detail-remaining },
                    ]: HorizontalLayout {
                        height: 18px;
                        Text { text: row.k; color: Theme.subtext; font-size: 12px; vertical-alignment: center; }
                        Text { text: row.v; color: Theme.text; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
            }

            // Bottom bar: details toggle and recycle option.
            HorizontalLayout {
                height: 30px;
                padding-top: 4px;
                Rectangle {
                    width: toggle-row.preferred-width + 12px;
                    border-radius: 4px;
                    background: toggle-touch.pressed ? Theme.pressed : toggle-touch.has-hover ? Theme.hover : transparent;
                    animate background { duration: 120ms; }
                    toggle-row := HorizontalLayout {
                        x: 6px;
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 10px;
                                height: 8px;
                                viewbox-width: 10;
                                viewbox-height: 8;
                                commands: "M 1 \{2 + 4 * root.chevron} L 5 \{6 - 4 * root.chevron} L 9 \{2 + 4 * root.chevron}";
                                stroke: Theme.text;
                                stroke-width: 1.2px;
                                stroke-line-cap: round;
                                fill: transparent;
                            }
                        }
                        Text {
                            text: root.expanded ? "简略信息" : "详细信息";
                            font-size: 12px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    toggle-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-details(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                CheckBox {
                    text: "解压完成后移入回收站";
                    checked <=> root.recycle-checked;
                    enabled: root.controls-enabled;
                    toggled => { root.recycle-toggled(self.checked); }
                }
            }
        }
    }

    // ===================== Prompt sheet =====================
    if root.prompt-open: TouchArea {
        // Swallow clicks meant for the hidden main content.
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }
    sheet-host := Rectangle {
        x: 0px;
        y: root.prompt-open ? 0px : 16px;
        width: root.width;
        height: root.height;
        opacity: root.prompt-open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate y { duration: 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: 200ms; easing: ease-out; }

        sheet := VerticalLayout {
            x: 0px;
            y: 0px;
            width: root.width;
            spacing: 0px;
            alignment: start;

            VerticalLayout {
                padding: 20px;
                padding-bottom: 16px;
                spacing: 10px;
                Text {
                    text: root.prompt-title;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                }

                if root.prompt == PromptKind.password: VerticalLayout {
                    spacing: 8px;
                    Text { text: "此压缩包受密码保护，请输入解压密码："; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                    LineEdit {
                        input-type: password;
                        placeholder-text: "密码";
                        text <=> root.prompt-input;
                        accepted => { root.prompt-accepted(); }
                        init => { self.focus(); }
                    }
                }

                if root.prompt == PromptKind.invalid-names: VerticalLayout {
                    spacing: 8px;
                    Text { text: "压缩包内包含 Windows 不支持的字符或保留名称："; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                    Rectangle {
                        height: min(names.preferred-height + 12px, 96px);
                        background: Theme.card;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 4px;
                        ScrollView {
                            names := VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                for line in root.invalid-names: Text { text: line; font-size: 11px; color: Theme.subtext; wrap: word-wrap; }
                            }
                        }
                    }
                    Radio {
                        text: "批量重命名：将非法字符替换为 “-”（推荐）";
                        checked: root.prompt-choice == 0;
                        clicked => { root.prompt-choice = 0; }
                    }
                    Radio {
                        text: "仅提取可表示的文件（跳过这些项，源包将保留）";
                        checked: root.prompt-choice == 1;
                        clicked => { root.prompt-choice = 1; }
                    }
                    CheckBox { text: "记住我的选择，以后不再询问"; checked <=> root.prompt-remember; }
                }

                if root.prompt == PromptKind.encoding: VerticalLayout {
                    spacing: 8px;
                    Text { text: "文件名缺少可靠的编码声明，请选择能正确显示文件名的编码："; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                    Rectangle {
                        height: min(choices.preferred-height + 12px, 170px);
                        background: Theme.card;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 4px;
                        ScrollView {
                            choices := VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                for choice[i] in root.encodings: Radio {
                                    text: choice.label;
                                    detail: choice.samples;
                                    checked: root.prompt-choice == i;
                                    clicked => { root.prompt-choice = i; }
                                }
                            }
                        }
                    }
                    CheckBox { text: "记住我的选择，以后不再询问"; checked <=> root.prompt-remember; }
                }

                if root.prompt == PromptKind.recycle-notice: Text {
                    text: "解压并逐项校验成功后，源压缩包会移入回收站。分卷压缩包会整组移入；TAR 等缺少内容校验的格式会在回收前额外核对摘要。";
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                if root.prompt == PromptKind.budget: VerticalLayout {
                    spacing: 8px;
                    Text { text: root.prompt-detail; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                    Text { text: "本次解压上限（MiB）"; font-size: 12px; color: Theme.subtext; }
                    LineEdit {
                        input-type: number;
                        text <=> root.prompt-input;
                        accepted => { root.prompt-accepted(); }
                        init => { self.focus(); }
                    }
                    if root.prompt-error != "": Text { text: root.prompt-error; font-size: 12px; color: Theme.danger; wrap: word-wrap; }
                }
            }

            Rectangle {
                height: 64px;
                background: Theme.footer;
                Rectangle { y: 0px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 8px;
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        AccentButton {
                            width: 110px;
                            text: root.prompt-submit;
                            clicked => { root.prompt-accepted(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        AccentButton {
                            width: 110px;
                            text: "取消";
                            primary: false;
                            clicked => { root.prompt-dismissed(); }
                        }
                    }
                }
            }
        }
    }
}
